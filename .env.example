# Every variable the app reads (SPEC.md Section 14). Copy to .env.local and fill in.
# Never commit .env.local. Never log a value. Never return a value to a model.

DATABASE_URL=                # Neon Postgres (dev branch locally; main in Vercel production)
DB_CONNECT_TIMEOUT_SECONDS=  # optional; default 8. Lower it where no database is reachable (CI builds)
AI_GATEWAY_API_KEY=          # Vercel AI Gateway (every model call, and Jev for the matchup odds)
WEB_SEARCH_PROVIDER=tavily   # tavily | exa | brave
WEB_SEARCH_API_KEY=          # key for the provider above
COMMISSIONER_PASSWORD=       # admin login
SESSION_SECRET=              # optional; cookie signing key. Unset, it is derived from
                             # COMMISSIONER_PASSWORD (which must then be 16+ chars).
                             # Set it to opt out: openssl rand -base64 32
CRON_SECRET=                 # protects /api/cron/tick
SITE_DOMAIN=                 # e.g. league.example.com (blocked in agent web tools)
LEAGUE_SEASON=2026
LEAGUE_TZ=America/New_York
ALERT_EMAIL_TO=              # cost alarms, health alerts, weekly digest
RESEND_API_KEY=              # email sending
ALERT_WEBHOOK_URL=           # optional; alarms POSTed as JSON
SIMULATION_MODE=false        # true enables clock_override and fixture data
